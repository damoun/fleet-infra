{
  "port": 8000,
  "outputTransport": "streamableHttp",
  "stateful": true,
  "sessionTimeout": 900000,
  "healthEndpoint": "/healthz",
  "logLevel": "none",
  "mcpServers": {
    "notes": {
      "command": "/app/node_modules/.bin/mcp-server-filesystem",
      "args": ["--confine-roots", "/notes"],
      "tools": [
        "list_allowed_directories",
        "list_directory",
        "directory_tree",
        "search_files",
        "get_file_info",
        "read_text_file",
        "read_multiple_files",
        "write_file",
        "edit_file",
        "append_file",
        "create_directory"
      ]
    }
  }
}
