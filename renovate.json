{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>damoun/renovate-config"
  ],
  "flux": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/sources/git-.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*# tag: (?<currentValue>\\S+)\\n\\s*commit: (?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/configs/flux-instance\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/controllers/vm\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) tag=(?<currentValue>\\S+)( versioning=(?<versioning>\\S+))?\\n\\s*url: https://raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentDigest>[a-f0-9]{40})/"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "flux"
      ],
      "matchDepNames": [
        "gateway-api"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "victoriametrics/operator"
      ],
      "matchCurrentValue": "/^config-reloader-/",
      "versioning": "regex:^config-reloader-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "groupName": "VictoriaMetrics",
      "matchDepNames": [
        "victoriametrics/victoria-metrics",
        "victoriametrics/vmagent",
        "VictoriaMetrics/VictoriaMetrics"
      ]
    },
    {
      "groupName": "VictoriaMetrics operator",
      "matchDepNames": [
        "victoriametrics/operator",
        "VictoriaMetrics/operator"
      ]
    }
  ]
}
