{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>damoun/renovate-config"
  ],
  "flux": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/sources/git-.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*# tag: (?<currentValue>\\S+)\\n\\s*commit: (?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "helm-values",
        "kubernetes"
      ],
      "matchFileNames": [
        "**/gotk-components.yaml"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "flux"
      ],
      "matchDepNames": [
        "gateway-api"
      ],
      "enabled": false
    }
  ]
}
