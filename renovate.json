{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>damoun/renovate-config"
  ],
  "flux": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "helm-values",
        "kubernetes"
      ],
      "matchFileNames": [
        "**/gotk-components.yaml"
      ],
      "enabled": false
    }
  ]
}
